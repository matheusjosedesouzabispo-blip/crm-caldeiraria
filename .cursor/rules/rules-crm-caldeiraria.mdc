├── estruturas-sob-desenho/
│   └── index.html          # Página do serviço Estruturas Sob Desenho
├── componentes-para-transporte/
│   └── index.html          # Página do serviço Componentes para Transporte
├── soldas-especiais/
│   └── index.html          # Página do serviço Soldas Especiais
├── quem-somos/
│   └── index.html          # Página Quem Somos
├── contato/
│   └── index.html          # Página de Contato (canais + CTA WhatsApp)
├── depoimentos/
